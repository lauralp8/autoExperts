          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  instance_name,\n  location_name,\n  source_path,\n  destination_path,\n  policy,\n  state,\n  health_status,\n  lag_minutes,\n  alert_level,\n  collected_at as last_check\nFROM v_snapmirror_detail\nORDER BY \n  CASE alert_level\n    WHEN 'critical' THEN 1\n    WHEN 'error' THEN 2\n    WHEN 'warning' THEN 3\n    WHEN 'ok' THEN 4\n    ELSE 5\n  END,\n  lag_minutes DESC\nLIMIT 500",
          "refId": "A"
        }
      ],
      "title": "All SnapMirror Relationships - Status Overview",
      "type": "table"
    },
