      "targets": [
        {
          "dataset": "snapmirror_monitoring",
          "datasource": {
            "type": "mysql",
            "uid": null
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  collected_at as time,\n  CONCAT(i.name, ' - ', r.source_path) as metric,\n  h.lag_seconds / 60 as value\nFROM snapmirror_status_history h\nINNER JOIN snapmirror_relationships r ON h.relationship_id = r.id\nINNER JOIN ontap_instances i ON h.instance_id = i.id\nWHERE \n  h.collected_at >= NOW() - INTERVAL 24 HOUR\nORDER BY collected_at",
          "refId": "A"
        }
      ],
      "title": "Lag Trend - Last 24 Hours (All Relations)",
      "type": "timeseries"
