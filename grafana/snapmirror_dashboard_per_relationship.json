      "targets": [
        {
          "dataset": "snapmirror_monitoring",
          "datasource": {
            "type": "mysql",
            "uid": null
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  UNIX_TIMESTAMP(ssh.collected_at) as time,\n  ssh.lag_seconds as value,\n  CONCAT(oi.name, ' - ', sr.source_path, ' → ', sr.destination_path) as metric\nFROM snapmirror_status_history ssh\nINNER JOIN snapmirror_relationships sr ON ssh.relationship_id = sr.id\nINNER JOIN ontap_instances oi ON sr.instance_id = oi.id\nWHERE ssh.collected_at >= NOW() - INTERVAL 24 HOUR\nORDER BY ssh.collected_at",
          "refId": "A"
        }
      ],
      "title": "Lag History (Last 24h)",
