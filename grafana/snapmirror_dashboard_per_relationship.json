      "targets": [
        {
          "dataset": "snapmirror_monitoring",
          "datasource": {
            "type": "mysql",
            "uid": null
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  sr.source_path as volume_name,\n  oi.name as instance_name,\n  oi.ip_address,\n  oi.latitude,\n  oi.longitude,\n  oi.location_name,\n  sr.source_path,\n  sr.destination_path,\n  sr.policy,\n  ssc.lag_seconds,\n  ssc.lag_minutes,\n  ssc.state,\n  ssc.health_status,\n  ssc.transfer_state,\n  ssc.alert_level,\n  ssc.error_message,\n  ssc.collected_at as last_check\nFROM snapmirror_relationships sr\nINNER JOIN ontap_instances oi ON sr.instance_id = oi.id\nLEFT JOIN snapmirror_status_current ssc ON sr.id = ssc.relationship_id\nWHERE oi.is_active = TRUE\nORDER BY ssc.alert_level DESC, sr.source_path",
          "refId": "A"
        }
      ],
      "title": "SnapMirror Relationships Map (One Point Per Relationship)",
      "type": "geomap"
    },
